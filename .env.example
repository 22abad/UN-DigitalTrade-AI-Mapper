# LLM Provider API Keys (set at least one)
GEMINI_API_KEY=
CLAUDE_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=

# Active provider: gemini / claude / openai / deepseek / groq / llama3
RDTII_LLM_PROVIDER=gemini

# Optional model overrides
# GEMINI_MODEL=gemini-2.0-flash
# CLAUDE_MODEL=claude-sonnet-4-20250514

# Database (defaults match docker-compose)
POSTGRES_DB=rdtii
POSTGRES_USER=rdtii_user
POSTGRES_PASSWORD=rdtii_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# CORS
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000
